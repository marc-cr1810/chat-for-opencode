{
  "name": "opencode-vscode",
  "displayName": "OpenCode for VS Code",
  "description": "Chat with OpenCode agents from VS Code's secondary side bar.",
  "version": "0.4.0",
  "publisher": "local",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marc-cr1810/opencode-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode-sidebar",
          "title": "OpenCode",
          "icon": "media/icon-mono.svg"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.openInTab",
        "title": "OpenCode: Open in New Tab",
        "icon": "media/icon-mono.svg"
      },
      {
        "command": "opencode.openInSidebar",
        "title": "OpenCode: Open in Side Bar"
      },
      {
        "command": "opencode.focus",
        "title": "OpenCode: Focus Input"
      },
      {
        "command": "opencode.newSession",
        "title": "OpenCode: New Conversation"
      },
      {
        "command": "opencode.insertAtMention",
        "title": "Add Selection to Prompt",
        "category": "OpenCode"
      },
      {
        "command": "opencode.restartServer",
        "title": "OpenCode: Restart Server"
      },
      {
        "command": "opencode.explainSelection",
        "title": "Explain",
        "category": "OpenCode"
      },
      {
        "command": "opencode.refactorSelection",
        "title": "Refactor",
        "category": "OpenCode"
      },
      {
        "command": "opencode.testSelection",
        "title": "Write Tests",
        "category": "OpenCode"
      },
      {
        "command": "opencode.fixDiagnostic",
        "title": "Fix with OpenCode"
      },
      {
        "command": "opencode.openSettingsPanel",
        "title": "OpenCode: Settings (Providers, MCP)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode.openInTab",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "submenu": "opencode.editorContext",
          "group": "1_opencode@1"
        }
      ],
      "opencode.editorContext": [
        {
          "command": "opencode.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "opencode.refactorSelection",
          "group": "1_ask@2"
        },
        {
          "command": "opencode.testSelection",
          "group": "1_ask@3"
        },
        {
          "command": "opencode.insertAtMention",
          "group": "2_prompt@1"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode.fixDiagnostic",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.focus",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "opencode.openInTab",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o"
      },
      {
        "command": "opencode.insertAtMention",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.binaryPath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode executable."
        },
        "opencode.autoApproveEdits": {
          "type": "boolean",
          "default": false,
          "description": "Apply file edits without asking in new conversations. Shell commands always ask."
        },
        "opencode.autoApproveReadOnly": {
          "type": "boolean",
          "default": false,
          "description": "In read-only agents such as plan, run read-only shell commands (ls, grep, git log…) without asking. Commands with redirects or write/exec flags still ask."
        },
        "opencode.model": {
          "type": "string",
          "default": "",
          "description": "Default model as provider/model (e.g. opencode/big-pickle). Empty uses OpenCode's default."
        },
        "opencode.preferredLocation": {
          "type": "string",
          "enum": [
            "panel",
            "sidebar"
          ],
          "default": "sidebar",
          "description": "Where Ctrl+Alt+O opens OpenCode when no chat is open."
        },
        "opencode.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when OpenCode finishes or needs approval while no visible OpenCode panel has that conversation open."
        },
        "opencode.defaultAgent": {
          "type": "string",
          "default": "",
          "markdownDescription": "Agent a new conversation starts in, such as `build` or `plan`. Empty uses OpenCode's default."
        },
        "opencode.sendKey": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "enumDescriptions": [
            "Enter sends, Shift+Enter adds a new line",
            "Ctrl+Enter (Cmd+Enter on Mac) sends, Enter adds a new line"
          ],
          "default": "enter",
          "description": "Key that sends a message."
        },
        "opencode.includeSelection": {
          "type": "boolean",
          "default": true,
          "description": "Share the current editor file and selection with OpenCode by default. You can still toggle it per message with the eye button."
        },
        "opencode.reasoning": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded"
          ],
          "default": "collapsed",
          "description": "Whether the model's reasoning starts collapsed or expanded."
        },
        "opencode.toolOutput": {
          "type": "string",
          "enum": [
            "auto",
            "expanded",
            "collapsed"
          ],
          "enumDescriptions": [
            "Edit diffs and to-do lists open, everything else collapsed",
            "Every tool step open",
            "Every tool step collapsed"
          ],
          "default": "auto",
          "description": "Which tool steps start expanded."
        },
        "opencode.notifyWhenFinished": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Notify when a task finishes. Turn off to only be notified when OpenCode needs your approval. Has no effect when `#opencode.notifications#` is off."
        },
        "opencode.contextWarningPercent": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "How full the context window gets (in %) before the context meter turns amber and suggests compacting. It turns red at 90%, or at this value if it's higher."
        },
        "opencode.stallWarningSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Show a warning when the model hasn't sent anything for this many seconds. Time spent running tools doesn't count. 0 turns it off."
        },
        "opencode.responseTimeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Stop the request when the model hasn't sent anything for this many seconds, so you can retry. Time spent running tools doesn't count. 0 turns it off."
        }
      }
    },
    "submenus": [
      {
        "id": "opencode.editorContext",
        "label": "OpenCode"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "diff": "^5.2.0",
    "esbuild": "^0.28.2",
    "marked": "^12.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
