{
  "name": "chat-for-opencode",
  "displayName": "Chat for OpenCode",
  "description": "Unofficial chat panel for OpenCode agents in VS Code's side bar. Not affiliated with or endorsed by OpenCode.",
  "version": "0.5.1",
  "publisher": "local",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marc-cr1810/chat-for-opencode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencodeChat-sidebar",
          "title": "Chat for OpenCode",
          "icon": "media/icon-mono.svg"
        }
      ]
    },
    "views": {
      "opencodeChat-sidebar": [
        {
          "type": "webview",
          "id": "opencodeChat.chatView",
          "name": "Chat for OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeChat.openInTab",
        "title": "Chat for OpenCode: Open in New Tab",
        "icon": "media/icon-mono.svg"
      },
      {
        "command": "opencodeChat.openInSidebar",
        "title": "Chat for OpenCode: Open in Side Bar"
      },
      {
        "command": "opencodeChat.focus",
        "title": "Chat for OpenCode: Focus Input"
      },
      {
        "command": "opencodeChat.newSession",
        "title": "Chat for OpenCode: New Conversation"
      },
      {
        "command": "opencodeChat.insertAtMention",
        "title": "Add Selection to Prompt",
        "category": "Chat for OpenCode"
      },
      {
        "command": "opencodeChat.restartServer",
        "title": "Chat for OpenCode: Restart Server"
      },
      {
        "command": "opencodeChat.explainSelection",
        "title": "Explain",
        "category": "Chat for OpenCode"
      },
      {
        "command": "opencodeChat.refactorSelection",
        "title": "Refactor",
        "category": "Chat for OpenCode"
      },
      {
        "command": "opencodeChat.testSelection",
        "title": "Write Tests",
        "category": "Chat for OpenCode"
      },
      {
        "command": "opencodeChat.fixDiagnostic",
        "title": "Fix with OpenCode"
      },
      {
        "command": "opencodeChat.openSettingsPanel",
        "title": "Chat for OpenCode: Settings (Providers, MCP)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencodeChat.openInTab",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "submenu": "opencodeChat.editorContext",
          "group": "1_opencode@1"
        }
      ],
      "opencodeChat.editorContext": [
        {
          "command": "opencodeChat.explainSelection",
          "group": "1_ask@1"
        },
        {
          "command": "opencodeChat.refactorSelection",
          "group": "1_ask@2"
        },
        {
          "command": "opencodeChat.testSelection",
          "group": "1_ask@3"
        },
        {
          "command": "opencodeChat.insertAtMention",
          "group": "2_prompt@1"
        }
      ],
      "commandPalette": [
        {
          "command": "opencodeChat.fixDiagnostic",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencodeChat.focus",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "opencodeChat.openInTab",
        "key": "ctrl+alt+shift+o",
        "mac": "cmd+alt+shift+o"
      },
      {
        "command": "opencodeChat.insertAtMention",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Chat for OpenCode",
      "properties": {
        "opencodeChat.binaryPath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode executable."
        },
        "opencodeChat.autoApproveEdits": {
          "type": "boolean",
          "default": false,
          "description": "Apply file edits without asking in new conversations. Shell commands always ask."
        },
        "opencodeChat.autoApproveReadOnly": {
          "type": "boolean",
          "default": false,
          "description": "In read-only agents such as plan, run read-only shell commands (ls, grep, git log…) without asking. Commands with redirects or write/exec flags still ask."
        },
        "opencodeChat.model": {
          "type": "string",
          "default": "",
          "description": "Default model as provider/model (e.g. opencode/big-pickle). Empty uses OpenCode's default."
        },
        "opencodeChat.preferredLocation": {
          "type": "string",
          "enum": [
            "panel",
            "sidebar"
          ],
          "default": "sidebar",
          "description": "Where Ctrl+Alt+O opens OpenCode when no chat is open."
        },
        "opencodeChat.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when OpenCode finishes or needs approval while no visible OpenCode panel has that conversation open."
        },
        "opencodeChat.defaultAgent": {
          "type": "string",
          "default": "",
          "markdownDescription": "Agent a new conversation starts in, such as `build` or `plan`. Empty uses OpenCode's default."
        },
        "opencodeChat.sendKey": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "enumDescriptions": [
            "Enter sends, Shift+Enter adds a new line",
            "Ctrl+Enter (Cmd+Enter on Mac) sends, Enter adds a new line"
          ],
          "default": "enter",
          "description": "Key that sends a message."
        },
        "opencodeChat.includeSelection": {
          "type": "boolean",
          "default": true,
          "description": "Share the current editor file and selection with OpenCode by default. You can still toggle it per message with the eye button."
        },
        "opencodeChat.reasoning": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded"
          ],
          "default": "collapsed",
          "description": "Whether the model's reasoning starts collapsed or expanded."
        },
        "opencodeChat.toolOutput": {
          "type": "string",
          "enum": [
            "auto",
            "expanded",
            "collapsed"
          ],
          "enumDescriptions": [
            "Edit diffs and to-do lists open, everything else collapsed",
            "Every tool step open",
            "Every tool step collapsed"
          ],
          "default": "auto",
          "description": "Which tool steps start expanded."
        },
        "opencodeChat.notifyWhenFinished": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Notify when a task finishes. Turn off to only be notified when OpenCode needs your approval. Has no effect when `#opencodeChat.notifications#` is off."
        },
        "opencodeChat.contextWarningPercent": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 100,
          "description": "How full the context window gets (in %) before the context meter turns amber and suggests compacting. It turns red at 90%, or at this value if it's higher."
        },
        "opencodeChat.stallWarningSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Show a warning when the model hasn't sent anything for this many seconds. Time spent running tools doesn't count. 0 turns it off."
        },
        "opencodeChat.responseTimeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Stop the request when the model hasn't sent anything for this many seconds, so you can retry. Time spent running tools doesn't count. 0 turns it off."
        }
      }
    },
    "submenus": [
      {
        "id": "opencodeChat.editorContext",
        "label": "Chat for OpenCode"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "diff": "^5.2.0",
    "esbuild": "^0.28.2",
    "marked": "^12.0.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
